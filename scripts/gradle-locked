#!/usr/bin/env bash
#
# gradle-locked — run `./gradlew "$@"` under a machine-global build semaphore.
#
# Why: each git worktree is a separate Gradle root, so N agents working in
# parallel each spawn their own Gradle daemon (-Xmx4g) + Kotlin daemon (-Xmx4g)
# + test JVM (2g), and each build defaults to max-workers = all CPU cores. On an
# 8-core/32GB box, three concurrent `./gradlew test` runs oversubscribe memory
# and CPU so badly that individual tests blow past the 300s HardTimeoutWatchdog
# hard cap (see TestHangGuard) and the whole run is halted — every agent "times
# out" at once.
#
# This wrapper limits heavy invocations to two at a time across ALL worktrees on
# this machine; the rest queue (with a visible message) and run as soon as a slot
# frees. Three concurrent builds oversubscribe the machine, while two let agents
# make progress in parallel without crossing that threshold.
#
# The lock lives at a fixed, worktree-independent path so every worktree's copy
# of this script contends for the same lock. shlock (shipped with macOS) is
# PID-aware: it auto-clears the lock if the holding process has died, so a
# crashed/killed run never wedges the queue.
#
# Tunables (env):
#   GRADLE_LOCK_TIMEOUT  seconds to wait before giving up (default 1800 = 30m)
#   GRADLE_LOCK_FILE     override the lock path (default ~/.cache/argentum/gradle.lock)
#   GRADLE_LOCK_SLOTS    maximum concurrent Gradle runs (default 2)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENGINE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
OUTER_BUILD_LOCK="$SCRIPT_DIR/../../../scripts/build-locked"

# When this maintained fork is checked out under MTGallium, use the outer
# portable semaphore so direct fork recipes and outer Gradle recipes contend
# for the same machine-wide lock. Standalone Argentum checkouts keep the
# historical two-slot shlock path below.
if [ -x "$OUTER_BUILD_LOCK" ]; then
    exec "$OUTER_BUILD_LOCK" "$ENGINE_ROOT/gradlew" "$@"
fi

LOCK_FILE="${GRADLE_LOCK_FILE:-$HOME/.cache/argentum/gradle.lock}"
TIMEOUT="${GRADLE_LOCK_TIMEOUT:-1800}"
SLOTS="${GRADLE_LOCK_SLOTS:-2}"
POLL=5

if ! [[ "$SLOTS" =~ ^[1-9][0-9]*$ ]]; then
    echo "gradle-locked: GRADLE_LOCK_SLOTS must be a positive integer (got '$SLOTS')." >&2
    exit 2
fi

mkdir -p "$(dirname "$LOCK_FILE")"

if ! command -v shlock >/dev/null 2>&1; then
    echo "gradle-locked: 'shlock' not found and no outer portable semaphore is available; refusing an un-serialized build" >&2
    exit 69
fi

elapsed=0
acquired_lock=""
while [ -z "$acquired_lock" ]; do
    for ((slot = 1; slot <= SLOTS; slot++)); do
        # Keep slot 1 at the historical path so a build started by an older
        # version of this wrapper still consumes one of the available slots.
        slot_lock="$LOCK_FILE"
        if [ "$slot" -gt 1 ]; then
            slot_lock="${LOCK_FILE}.${slot}"
        fi
        if shlock -f "$slot_lock" -p $$; then
            acquired_lock="$slot_lock"
            break
        fi
    done

    if [ -n "$acquired_lock" ]; then
        break
    fi

    if [ "$elapsed" -ge "$TIMEOUT" ]; then
        echo "gradle-locked: gave up after ${TIMEOUT}s waiting for one of ${SLOTS} Gradle slots." >&2
        exit 1
    fi
    if [ "$elapsed" -eq 0 ]; then
        echo "gradle-locked: all ${SLOTS} Gradle slots are busy — queuing (timeout ${TIMEOUT}s)..." >&2
    fi
    sleep "$POLL"
    elapsed=$((elapsed + POLL))
done

# We hold the lock; ensure it is released on any exit (success, failure, signal).
trap 'rm -f "$acquired_lock"' EXIT INT TERM

"$ENGINE_ROOT/gradlew" "$@"
